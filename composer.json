{
  "name": "syrtis/php-json-schema-helper",
  "description": "Helper to build and resolve json schemas.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Syrtis",
      "email": "contact@syrtis.ai"
    }
  ],
  "require": {
    "php": ">=8.1",
    "opis/json-schema": "^2.6.0"
  },
  "autoload": {
    "psr-4": {
      "SyrtisJsonSchemaHelper\\": "src/"
    }
